{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/national-waterfall-window-v3.js": {
      "maxDuration": 25
    },
    "api/national-waterfall-window-v4.js": {
      "maxDuration": 25
    },
    "api/national-waterfall-window-v5.js": {
      "maxDuration": 25
    }
  },
  "redirects": [
    {
      "source": "/national-tools/niagara-falls-rainbow-planner",
      "destination": "/national-tools/niagara-rainbow/",
      "permanent": true
    },
    {
      "source": "/national-tools/niagara-falls-rainbow-planner/",
      "destination": "/national-tools/niagara-rainbow/",
      "permanent": true
    },
    {
      "source": "/national-tools/niagara-falls-rainbow-planner/:path*",
      "destination": "/national-tools/niagara-rainbow/",
      "permanent": true
    },
    {
      "source": "/national-tools/waterfalls/niagara-falls-live",
      "destination": "/national-tools/niagara-rainbow/",
      "permanent": true
    },
    {
      "source": "/national-tools/waterfalls/niagara-falls-live/",
      "destination": "/national-tools/niagara-rainbow/",
      "permanent": true
    },
    {
      "source": "/national-tools/waterfalls/niagara-falls-live/:path*",
      "destination": "/national-tools/niagara-rainbow/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/national-tools/smoke",
      "destination": "https://national-outdoor-core.vercel.app/national-tools/smoke/index.html"
    },
    {
      "source": "/national-tools/smoke/",
      "destination": "https://national-outdoor-core.vercel.app/national-tools/smoke/index.html"
    },
    {
      "source": "/national-tools/smoke/:path*",
      "destination": "https://national-outdoor-core.vercel.app/national-tools/smoke/:path*"
    },
    {
      "source": "/national-tools/waterfalls",
      "destination": "/national-tools/waterfalls/index.html"
    },
    {
      "source": "/national-tools/waterfalls/",
      "destination": "/national-tools/waterfalls/index.html"
    },
    {
      "source": "/national-tools/waterfalls/_search",
      "destination": "/api/national-waterfall-search"
    },
    {
      "source": "/national-tools/waterfalls/_api",
      "destination": "/api/national-waterfall-window-v5"
    },
    {
      "source": "/national-tools/waterfalls/_assets/:path*",
      "destination": "/assets/:path*"
    }
  ]
}