{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/national-waterfall-window-v3.js": { "maxDuration": 25 },
    "api/national-waterfall-window-v4.js": { "maxDuration": 25 },
    "api/national-waterfall-window-v5.js": { "maxDuration": 25 },
    "api/gauley-live.js": { "maxDuration": 25 },
    "api/gauley-history.js": { "maxDuration": 25 },
    "api/yosemite-firefall.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/national-tools/niagara-falls-rainbow-planner", "destination": "/national-tools/niagara-rainbow/", "permanent": true },
    { "source": "/national-tools/niagara-falls-rainbow-planner/", "destination": "/national-tools/niagara-rainbow/", "permanent": true },
    { "source": "/national-tools/niagara-falls-rainbow-planner/:path*", "destination": "/national-tools/niagara-rainbow/", "permanent": true },
    { "source": "/national-tools/waterfalls/niagara-falls-live", "destination": "/national-tools/niagara-rainbow/", "permanent": true },
    { "source": "/national-tools/waterfalls/niagara-falls-live/", "destination": "/national-tools/niagara-rainbow/", "permanent": true },
    { "source": "/national-tools/waterfalls/niagara-falls-live/:path*", "destination": "/national-tools/niagara-rainbow/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/national-tools/yosemite-firefall-live",
      "destination": "/national-tools/yosemite-firefall-live/index.html"
    },
    {
      "source": "/national-tools/yosemite-firefall-live/",
      "destination": "/national-tools/yosemite-firefall-live/index.html"
    },
    {
      "source": "/national-tools/yosemite-firefall-live/_api/live",
      "destination": "/api/yosemite-firefall"
    },
    {
      "source": "/national-tools/gauley-release-live",
      "destination": "/national-tools/gauley-release-live/index.html"
    },
    {
      "source": "/national-tools/gauley-release-live/",
      "destination": "/national-tools/gauley-release-live/index.html"
    },
    {
      "source": "/national-tools/gauley-release-live/api/live",
      "destination": "/api/gauley-live"
    },
    {
      "source": "/national-tools/gauley-release-live/api/history",
      "destination": "/api/gauley-history"
    },
    {
      "source": "/national-tools/elk-rut",
      "destination": "https://cdn.jsdelivr.net/gh/izworskic/rocky-mountain-elk-rut-live@a0b1247a6c7e844033461c5c27c8a57b92b540c4/public/national-tools/elk-rut/index.html"
    },
    {
      "source": "/national-tools/elk-rut/",
      "destination": "https://cdn.jsdelivr.net/gh/izworskic/rocky-mountain-elk-rut-live@a0b1247a6c7e844033461c5c27c8a57b92b540c4/public/national-tools/elk-rut/index.html"
    },
    {
      "source": "/national-tools/elk-rut/_api/live",
      "destination": "https://raw.githubusercontent.com/izworskic/rocky-mountain-elk-rut-live/main/public/v1/live.json"
    },
    {
      "source": "/national-tools/fort-madison-live",
      "destination": "https://fort-madison-live.vercel.app/"
    },
    {
      "source": "/national-tools/fort-madison-live/",
      "destination": "https://fort-madison-live.vercel.app/"
    },
    {
      "source": "/national-tools/fort-madison-live/:path*",
      "destination": "https://fort-madison-live.vercel.app/:path*"
    },
    {
      "source": "/national-tools/monarch-migration-live",
      "destination": "https://monarch-migration-live.vercel.app/national-tools/monarch-migration-live"
    },
    {
      "source": "/national-tools/monarch-migration-live/:path*",
      "destination": "https://monarch-migration-live.vercel.app/national-tools/monarch-migration-live/:path*"
    },
    {
      "source": "/national-tools/garden-water",
      "destination": "https://national-garden-water.vercel.app/national-tools/garden-water/"
    },
    {
      "source": "/national-tools/garden-water/",
      "destination": "https://national-garden-water.vercel.app/national-tools/garden-water/"
    },
    {
      "source": "/national-tools/garden-water/:path*",
      "destination": "https://national-garden-water.vercel.app/national-tools/garden-water/:path*"
    },
    {
      "source": "/national-tools/blue-spring-live/_api/live",
      "destination": "https://blue-spring-live-6h8f.vercel.app/api/live"
    },
    {
      "source": "/national-tools/blue-spring-live/_api/manatee",
      "destination": "https://blue-spring-live-6h8f.vercel.app/api/manatee"
    },
    {
      "source": "/assets/national-tools.css",
      "destination": "https://national-outdoor-core.vercel.app/assets/national-tools.css"
    },
    {
      "source": "/assets/national-tools.js",
      "destination": "https://national-outdoor-core.vercel.app/assets/national-tools.js"
    },
    {
      "source": "/api/national-geocode",
      "destination": "https://national-outdoor-core.vercel.app/api/national-geocode"
    },
    {
      "source": "/national-tools/smoke",
      "destination": "https://national-outdoor-core.vercel.app/national-tools/smoke/index.html"
    },
    {
      "source": "/national-tools/smoke/",
      "destination": "https://national-outdoor-core.vercel.app/national-tools/smoke/index.html"
    },
    {
      "source": "/national-tools/smoke/:path*",
      "destination": "https://national-outdoor-core.vercel.app/national-tools/smoke/:path*"
    },
    {
      "source": "/national-tools/waterfalls",
      "destination": "/national-tools/waterfalls/index.html"
    },
    {
      "source": "/national-tools/waterfalls/",
      "destination": "/national-tools/waterfalls/index.html"
    },
    {
      "source": "/national-tools/waterfalls/_search",
      "destination": "/api/national-waterfall-search"
    },
    {
      "source": "/national-tools/waterfalls/_api",
      "destination": "/api/national-waterfall-window-v5"
    },
    {
      "source": "/national-tools/waterfalls/_assets/:path*",
      "destination": "/assets/:path*"
    }
  ],
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public"
}
